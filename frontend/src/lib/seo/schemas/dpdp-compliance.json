    "@context": "https://schema.org",
    "@type": "HowTo",
    "name": "How ISECURION Delivers DPDP Compliance in India",
    "description": "A five-phase methodology used by ISECURION to help organizations achieve DPDP compliance in India, from data discovery to ongoing audit support.",
    "step": [
      {
        "@type": "HowToStep",
        "position": 1,
        "name": "Discovery & Data Mapping",
        "text": "Identify personal data assets, data flows, processing activities, third-party processors, and existing security controls."
      },
      {
        "@type": "HowToStep",
        "position": 2,
        "name": "Security Gap Analysis",
        "text": "Map identified controls against DPDP's security obligations and produce a prioritized gap report with risk ratings and VAPT scope definition."
      },
      {
        "@type": "HowToStep",
        "position": 3,
        "name": "VAPT & Technical Audit",
        "text": "Execute penetration testing of personal data-handling systems and assess encryption, IAM, monitoring, secure code, and vendor security posture."
      },
      {
        "@type": "HowToStep",
        "position": 4,
        "name": "Controls & Documentation",
        "text": "Implement remediation, security controls, breach response playbooks, RoPA, DPIA (for SDFs) and compliance documentation."
      },
      {
        "@type": "HowToStep",
        "position": 5,
        "name": "Audit Report & Ongoing Support",
        "text": "Deliver a DPDP security audit report, train teams on breach notification obligations, and provide periodic re-assessment support."
      }
    ]
  }
